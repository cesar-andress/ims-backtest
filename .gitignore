# =====================================================================
# ALLOWLIST: only the experiment is versioned.
# Everything at the top level is ignored unless explicitly allowed below.
# Not versioned (local only): SPEC.md, PROMPTS.md, .cursor/, notebooks/,
# manuscript/, any LaTeX, raw third-party data.
# =====================================================================
/*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/.zenodo.json
!/pyproject.toml
!/uv.lock
!/Makefile
!/config/
!/src/
!/tests/
!/scripts/
!/data/
!/outputs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/

# Data: downloads and derived data are rebuilt by the pipeline
data/raw/
data/interim/
data/processed/
*.parquet

# Third-party manual drops: only READMEs are versioned
# (licences of BACI, CEPII and Hofstede restrict redistribution)
data/manual/baci/*
!data/manual/baci/README.md
data/manual/cepii_gravity/*
!data/manual/cepii_gravity/README.md
data/manual/hofstede/*
!data/manual/hofstede/README.md

# Run logs (keep the reproducible build manifest + refs check)
outputs/logs/*
!outputs/logs/build.json
!outputs/logs/refs_check.md
!outputs/logs/refs_check.json

# Never in this repo, wherever they appear
*.tex
*.bib
*.cls
*.sty
*.docx
*.xlsx
*.pdf
*.ipynb
.env
.DS_Store
*.swp
*~
.~lock.*
